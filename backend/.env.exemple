# ==========================================================
# Modelo das variáveis de ambiente do projeto.
# Copie para ".env" (cp .env.example .env) e preencha os valores.
# O arquivo ".env" real NUNCA deve ser versionado.
# Regras: sem aspas, sem espaços ao redor do "=" e sem "$" nos valores
# ==========================================================

# --- Banco de dados (usado pelo compose e pela aplicação) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
# Gere com: openssl rand -hex 16
DB_PASSWORD=troque-por-uma-senha-forte

# --- JWT ---
# Obrigatório, sem valor padrão. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
JWT_EXPIRATION_HOURS=2

# --- Aplicação ---
SERVER_PORT=8080
# true apenas em desenvolvimento (loga todo SQL no console)
JPA_SHOW_SQL=false
VIACEP_URL=https://viacep.com.br/ws
